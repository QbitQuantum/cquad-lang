    for (auto tmp = init(); const auto& [k, v] : map) { }
    
    CompilationContext* ctx = new CompilationContext();
    int address = ctx->generateCode();
    std::print(address);

    switch (address) {
    case BAD_ALLOC: { address = ctx->generateCode(); } break;
    default:                 std::print(ctx->getDeadCode()); break;
    }

    if (address == BAD_ALLOC)
    {
        int stack = 0;
        stack++; ++stack;
        ++stack++;
        int retries = 0;
        while (retries < 3)
        {
            address = ctx->generateCode();
            retries = retries + 1;
        }
    }
    else
    {
        ctx->generateCode();
        ctx->generateCode();
        std::print(ctx->getDeadCode());
        std::print(ctx->getInlineBudget());
        std::print(ctx->getStackSize());
    }
    delete ctx;
    OS[address];
