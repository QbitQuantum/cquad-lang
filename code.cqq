class MathUtils {
private:
    // Поля класса
    int lastResult;
    int operationCount;
    
public:
    // Конструктор
    void MathUtils() {
        lastResult = 0;
        operationCount = 0;
    }
    
    // Вычисление факториала
    int factorial(int n) {
        operationCount = operationCount + 1;
        
        if (n <= 1) {
            lastResult = 1;
            return 1;
        }
        
        int result = 1;
        int i = 2;
        while (i <= n) {
            result = result * i;
            i = i + 1;
        }
        
        lastResult = result;
        return result;
    }
    
    // Проверка на простоту
    bool isPrime(int n) {
        operationCount = operationCount + 1;
        
        if (n <= 1) {
            lastResult = 0;
            return false;
        }
        
        if (n == 2) {
            lastResult = 1;
            return true;
        }
        
        if (n % 2 == 0) {
            lastResult = 0;
            return false;
        }
        
        int i = 3;
        while (i * i <= n) {
            if (n % i == 0) {
                lastResult = 0;
                return false;
            }
            i = i + 2;
        }
        
        lastResult = 1;
        return true;
    }
    
    // Получение последнего результата
    int getLastResult() {
        return lastResult;
    }
    
    // Получение количества операций
    int getOperationCount() {
        return operationCount;
    }
    
    // Сброс счётчика операций
    void resetCounter() {
        operationCount = 0;
    }
}

int sumArray(int[5] arr) {
